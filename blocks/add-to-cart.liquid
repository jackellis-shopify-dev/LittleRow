{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  assign scoped_class = block.settings.style_class | append: '--' | append: block.id
  assign class = 'add-to-cart-button ' | append: block.settings.style_class | append: ' ' | append: scoped_class
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id
%}
{%- comment -%} Little Row: sold out reads "notify me" (see util-notify-me) {%- endcomment -%}
{%- capture notify_me_output -%}
  {%- render 'util-notify-me',
    product_resource: closest.product,
    variant: closest.product.selected_or_first_available_variant
  -%}
{%- endcapture -%}
{%- liquid
  assign notify_me = false
  if notify_me_output == 'true'
    assign notify_me = true
  endif
-%}
{%- comment -%} Little Row: continue-selling variants with no stock read "pre-order" (see util-preorder-label) {%- endcomment -%}
{%- capture preorder_label -%}
  {%- render 'util-preorder-label',
    product_resource: closest.product,
    variant: closest.product.selected_or_first_available_variant
  -%}
{%- endcapture -%}
{%- capture preorder_property_value -%}
  {%- render 'util-preorder-label',
    product_resource: closest.product,
    variant: closest.product.selected_or_first_available_variant,
    property_value: true
  -%}
{%- endcapture -%}
{%- liquid
  if can_add_to_cart and preorder_label != blank
    assign add_to_cart_text = preorder_label
  endif
  assign preorder_property_name = 'content.preorder_property' | t
-%}
{%- if settings.notify_me_when_sold_out and request.page_type == 'product' -%}
  {%- comment -%}
    Little Row: the Amp widget injects its own notify button (#BIS_trigger) beside this one. It
    reads the variant from the page URL's ?variant=, which Horizon never updates on a size change,
    so it stays shown or hidden for whichever size the page loaded on. This button replaces it.
  {%- endcomment -%}
  {% style %}
    #BIS_trigger,
    .BIS_trigger {
      display: none !important;
    }
  {% endstyle %}
{%- endif -%}
{% render 'button-custom-styles', block_settings: block.settings, block_id: block.id %}
{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}

<span
  {{ block.shopify_attributes }}
  style="--add-to-cart-font-case: {{ settings.button_text_case }};"
>
  {% render 'add-to-cart-button',
    id: id,
    class: class,
    can_add_to_cart: can_add_to_cart,
    show_icon: can_add_to_cart,
    product: closest.product,
    add_to_cart_text: add_to_cart_text,
    notify_me: notify_me,
    data_testid: 'standalone-add-to-cart'
  %}
  {%- comment -%}
    Little Row: marks the cart line as a pre-order (util-preorder-label). Always rendered, disabled
    when the size isn't a pre-order; product-form.js copies value and disabled on variant change.
  {%- endcomment -%}
  <input
    type="hidden"
    name="properties[{{ preorder_property_name | escape }}]"
    value="{{ preorder_property_value | escape }}"
    data-preorder-property
    {% unless can_add_to_cart and preorder_property_value != blank %}
      disabled
    {% endunless %}
  >

</span>

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-custom",
          "label": "t:options.custom"
        }
      ],
      "default": "button-secondary",
      "info": "t:info.edit_button_style_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    }
  ]
}
{% endschema %}
