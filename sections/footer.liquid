{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: start;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  /* ================================
   * Little Row footer
   * ================================ */

  /* Brand column (logo, blurb, sign-up) is wider than the link columns */
  @media screen and (min-width: 990px) {
    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: 1.4fr repeat(3, 1fr);
    }

    /* Five blocks (brand + shop, help, about, legal) stay on one row. Horizon caps the grid at
       four columns and would drop the fifth onto its own full-width row. */
    .footer-content:has(> :nth-child(5):last-child) {
      grid-template-columns: 1.4fr repeat(4, 1fr);
    }

    .footer-content--isolated-grid-item-desktop:has(> :nth-child(5):last-child) > :last-child {
      grid-column: auto;
    }
  }

  /* Tablet with five blocks: brand across the top, then the four link columns in one row */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content:has(> :nth-child(5):last-child) {
      grid-template-columns: repeat(4, 1fr);

      & > :first-child {
        grid-column: 1 / -1;
      }
    }

    .footer-content--isolated-grid-item-tablet:has(> :nth-child(5):last-child) > :last-child {
      grid-column: auto;
    }
  }

  .footer-content > .group-block:first-child {
    max-width: 320px;

    @media screen and (max-width: 749px) {
      max-width: none;
      margin-block-end: var(--gap-xl);
    }
  }

  /* Column titles and the sign-up label are small sans headings when the block's heading preset is
     left on "Default", so choosing a preset still applies. Colours come from each block's
     text colour settings. */
  .footer-content
    :is(.menu__heading, .email-signup__heading):not(.paragraph, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-family: var(--font-subheading--family);
    font-size: var(--font-size--sm);
    font-weight: var(--font-subheading--weight);
    line-height: var(--line-height--body-normal);
    text-transform: lowercase;
  }

  .footer-content .menu__heading__default {
    font-weight: inherit;
  }

  /* Link size comes from the menu block's "Link preset"; colour from its text colour setting */
  .footer-content .menu__item a {
    text-decoration: none;
  }

  .footer-content .email-signup__heading {
    margin-block-end: var(--margin-xs);
  }

  .footer-content .email-signup__input-group {
    gap: var(--gap-xs);
  }

  .footer-content .email-signup__button:not(.email-signup__button--integrated) {
    padding-block: var(--padding-sm);
    padding-inline: var(--padding-xl);
  }

  /* Mobile: link columns stack full width as accordions (Horizon's <accordion-custom>) */
  @media screen and (max-width: 749px) {
    .footer-content {
      gap: 0;
    }

    .footer-content .menu--accordion .menu__heading {
      min-height: var(--minimum-touch-target);
      padding-block: 14px;
      align-items: center;
    }

    .footer-content .menu--dividers .menu__details {
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    }

    .footer-content .menu--accordion .details-content {
      margin-block-start: 0;
      padding-block-end: var(--padding-lg);
    }

    .footer-content .menu__item a {
      display: inline-block;
      padding-block: 4px;
    }

    .footer-content .email-signup__input-group:not(.email-signup__input-group--integrated) {
      flex-direction: column;
      align-items: stretch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill"
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
