{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="spacing-style"
    style="
      --horizontal-alignment: {{ section.settings.alignment }};
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <div
      class="search-page__header"
      {% if section.settings.panel_color != blank %}
        style="--search-panel-background: {{ section.settings.panel_color }};"
      {% endif %}
    >
      {%- comment -%}
        With a query, the heading is the quoted term and a line says how many pieces matched. The
        search field only shows when there's nothing to refine (no query, or no results); the
        header search overlay covers refining an existing search.
      {%- endcomment -%}
      {% capture heading_text %}
        {%- if search.performed -%}
          <h1>“{{ search.terms | escape }}”</h1>
        {%- else -%}
          <h1>{{ 'content.search' | t }}</h1>
        {%- endif -%}
      {% endcapture %}

      {% content_for 'block', id: 'heading', type: '_heading', text: heading_text %}

      {% if search.performed %}
        <p class="search-page__summary">
          {{ 'content.search_results_pieces' | t: count: search.results_count }}
        </p>
      {% endif %}

      {% if search.performed == false or search.results_count == 0 %}
        {% content_for 'block', id: 'search', type: '_search-input' %}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  /* Little Row: the search header is a panel inset within the page width ("Panel background" setting) */
  .search-page__header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: var(--padding-5xl) 40px;
    background-color: var(--search-panel-background, transparent);

    @media screen and (max-width: 749px) {
      padding: var(--padding-4xl) var(--padding-xl);
    }

    h1 {
      margin: 0;
      max-width: 16em;
    }

    search-page-input-component {
      margin-block: var(--margin-xs) 0;
    }
  }

  .search-page__summary {
    margin: 0;
    max-width: 34em;
    font-size: var(--font-size--md);
    line-height: var(--line-height--body-loose);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "t:settings.panel_background",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
