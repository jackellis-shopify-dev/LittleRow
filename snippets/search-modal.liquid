{% doc %}
  Renders the search overlay: a full-width panel that slides down from the top of the page, with
  search suggestions beside predictive product results. The form submits to the search page, so
  searching still works without JavaScript.

  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [class] - Additional CSS classes to apply to the predictive search component.
{% enddoc %}

{% render 'dialog-styles' %}
{% render 'predictive-search-styles' %}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<script
  src="{{ 'predictive-search.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign suggestions = settings.search_suggestions | split: ','
-%}

<dialog-component
  id="search-modal"
  class="search-modal"
  {{ block.shopify_attributes }}
>
  <dialog
    ref="dialog"
    class="search-modal__content dialog-modal"
    scroll-lock
    aria-labelledby="search-modal-heading"
  >
    <h2
      id="search-modal-heading"
      class="visually-hidden"
    >
      {{ 'content.search' | t }}
    </h2>
    <predictive-search-component
      class="predictive-search{% if class != blank %} {{ class | strip }}{% endif %}"
      style="--product-corner-radius: {{ settings.product_corner_radius | default: 0 | append: 'px' }}; --card-corner-radius: {{ settings.card_corner_radius | default: 0 | append: 'px' }};{% if settings.card_title_case == 'uppercase' %} --title-case: uppercase;{% endif %}"
      data-section-id="predictive-search"
      data-testid="search-component--modal"
    >
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="predictive-search-form search-modal__inner"
        ref="form"
        on:keydown="/onSearchKeyDown"
      >
        <div class="predictive-search-form__header">
          <div class="predictive-search-form__header-inner">
            <label
              for="cmdk-input"
              class="visually-hidden"
            >
              {{- 'content.search_input_label' | t -}}
            </label>
            <input
              class="search-input"
              id="cmdk-input"
              type="search"
              name="q"
              role="combobox"
              aria-expanded="false"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              aria-keyshortcuts="Meta+K Control+K"
              autocomplete="off"
              autofocus
              placeholder="{{ 'content.search_input_placeholder' | t }}"
              ref="searchInput"
              on:input="/search"
              on:keydown="/onSearchKeyDown"
            >
            <input
              name="options[prefix]"
              type="hidden"
              value="last"
            >
            <input
              name="type"
              type="hidden"
              value="product"
            >
            <span class="svg-wrapper predictive-search__icon">
              {{ 'icon-search.svg' | inline_asset_content }}
            </span>
            <button
              type="button"
              class="button-unstyled predictive-search__reset-button"
              ref="resetButton"
              hidden
              on:click="/resetSearch"
            >
              {{ 'actions.clear' | t }}
            </button>
          </div>
          <button
            type="button"
            class="button button-unstyled predictive-search__close-modal-button"
            aria-label="{{ 'accessibility.close_dialog' | t }}"
            on:click="dialog-component/closeDialog"
          >
            <span class="svg-wrapper">
              {{ 'icon-close.svg' | inline_asset_content }}
            </span>
          </button>
        </div>

        <div class="search-modal__body">
          {%- if suggestions.size > 0 -%}
            <nav
              class="search-modal__suggestions"
              aria-labelledby="search-modal-suggestions-title"
            >
              <p
                id="search-modal-suggestions-title"
                class="search-modal__label"
              >
                {{- 'content.search_suggestions_title' | t -}}
              </p>
              <ul class="search-modal__suggestion-list list-unstyled">
                {%- for suggestion in suggestions -%}
                  {%- assign term = suggestion | strip -%}
                  {%- if term != blank -%}
                    <li>
                      <a
                        class="search-modal__suggestion"
                        href="{{ routes.search_url }}?type=product&q={{ term | url_encode }}"
                        data-term="{{ term | escape }}"
                        on:click="/applySuggestion"
                      >
                        {{- term | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}

          <div
            class="predictive-search-form__content search-modal__results"
            ref="predictiveSearchResults"
          >
            {% render 'predictive-search-empty-state',
              load_empty_state: true,
              shadow_opacity: 0.1,
              products_test_id: 'products-list-default--modal'
            %}
          </div>
        </div>
      </form>
    </predictive-search-component>
  </dialog>
</dialog-component>

{% stylesheet %}
  /* ================================
   * Search overlay: full-width panel sliding down from the top
   * ================================ */
  .search-modal {
    --search-border-radius: 0;
    --search-border-width: 0;
  }

  .search-modal .search-modal__content.dialog-modal {
    position: fixed;
    inset: 0 0 auto;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    padding-block-start: var(--safe-area-inset-top);
    overflow-y: auto;
    border: 0;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: 0;
    box-shadow: none;
    background-color: var(--color-background);
  }

  .search-modal .search-modal__content[open] {
    display: block;
    animation: search-modal-slide-down var(--drawer-animation-speed) var(--animation-timing-fade-in) forwards;
  }

  .search-modal .search-modal__content.dialog-closing {
    animation: search-modal-slide-up var(--drawer-animation-speed) var(--animation-timing-fade-out) forwards;
  }

  .search-modal .search-modal__content::backdrop {
    display: block;
    background: rgb(var(--backdrop-color-rgb) / var(--backdrop-opacity));
    backdrop-filter: none;
  }

  @keyframes search-modal-slide-down {
    from {
      transform: translateY(-100%);
    }

    to {
      transform: translateY(0);
    }
  }

  @keyframes search-modal-slide-up {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-modal .search-modal__content[open],
    .search-modal .search-modal__content.dialog-closing {
      animation-duration: 1ms;
    }
  }

  .search-modal predictive-search-component {
    display: block;
    background-color: transparent;
  }

  .search-modal__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: var(--padding-2xl) var(--padding-4xl) var(--padding-4xl);

    @media screen and (max-width: 749px) {
      padding: var(--padding-lg) var(--padding-lg) var(--padding-2xl);
    }
  }

  /* Search field + close */
  .search-modal .dialog-modal .predictive-search-form__header {
    position: static;
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .search-modal .dialog-modal .predictive-search-form__header-inner {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    min-height: var(--minimum-touch-target);
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
    outline: none;
    box-shadow: none;

    &:focus-within {
      border-color: var(--color-foreground);
    }
  }

  .search-modal input.search-input {
    flex: 1;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding-block: var(--padding-sm);
    padding-inline: calc(var(--padding-md) + var(--icon-size-md) + var(--gap-xs)) var(--padding-md);
    font-size: var(--font-size--md);
    color: var(--color-input-text);
    background: transparent;
    border: 0;
    border-radius: 0;
    outline: none;
    box-shadow: none;
    text-overflow: ellipsis;
    appearance: none;

    &::placeholder {
      color: rgb(var(--color-input-text-rgb) / var(--opacity-muted-text));
    }

    &::-webkit-search-cancel-button {
      display: none;
    }
  }

  .search-modal .predictive-search__icon {
    position: absolute;
    inset-block: 0;
    left: var(--padding-md);
    display: grid;
    place-items: center;
    width: var(--icon-size-md);
    height: auto;
    margin: 0;
    color: rgb(var(--color-input-text-rgb) / var(--opacity-60));
    pointer-events: none;

    & > svg {
      width: var(--icon-size-sm);
      height: var(--icon-size-sm);
    }
  }

  .search-modal .predictive-search__reset-button {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-width: auto;
    height: var(--minimum-touch-target);
    padding: 0;
    margin-inline-end: var(--padding-md);
    font-size: var(--font-size--2xs);
    color: var(--text-muted);
    text-decoration: underline;
    text-transform: lowercase;
    background: transparent;
    cursor: pointer;

    &[hidden] {
      display: none;
    }
  }

  .search-modal .predictive-search__close-modal-button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
    margin: 0;
    padding: 0;
    color: var(--color-foreground);
    background: transparent;
    box-shadow: none;

    .svg-wrapper,
    svg {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }
  }

  /* Suggestions | results */
  .search-modal__body {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--gap-3xl);
    margin-block-start: 28px;

    @media screen and (max-width: 989px) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--gap-lg);
      margin-block-start: var(--margin-xl);
    }
  }

  .search-modal__label,
  .search-modal .predictive-search-results__title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-md);
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: var(--font-size--sm);
    font-weight: var(--font-subheading--weight);
    line-height: var(--line-height--body-normal);
    text-transform: lowercase;
    color: var(--text-subdued);
  }

  .search-modal__suggestions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .search-modal__suggestion-list {
    display: flex;
    flex-direction: column;
    gap: 10px;

    @media screen and (max-width: 989px) {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--gap-md);
    }
  }

  .search-modal__suggestion {
    font-size: var(--font-size--sm);
    color: var(--text-subdued);
    text-decoration: none;

    &:hover {
      color: var(--text-body);
    }
  }

  .search-modal .predictive-search-form__content {
    max-height: none;
    overflow: visible;
    background: transparent;
  }

  .search-modal .predictive-search-results__inner {
    padding: 0;
    overflow: visible;
  }

  .search-modal .predictive-search-results__products {
    padding: 0;
  }

  .search-modal .predictive-search-results__products:has(.recently-viewed-wrapper) .predictive-search-results__hint {
    display: none;
  }

  .search-modal .predictive-search-results__clear.button-unstyled {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: var(--font-body--weight);
    letter-spacing: normal;
    color: var(--text-subdued);
    text-decoration: underline;
    opacity: 1;
  }

  .search-modal .predictive-search-results__wrapper-products {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-block-start: 14px;
    padding: 0;

    @media screen and (max-width: 749px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Recently viewed shows 4 (sections/predictive-search.liquid): one row on desktop, 2 x 2 on mobile */
  .search-modal .recently-viewed-wrapper .predictive-search-results__wrapper-products {
    grid-template-columns: repeat(4, minmax(0, 1fr));

    @media screen and (max-width: 749px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .search-modal .predictive-search-results__no-results {
    margin-block: 14px 0;
    font-size: var(--font-size--sm);
    color: var(--text-subdued);
    text-align: start;
  }

  /* Cards: centred title and price; the highlighted result gets a quiet outline */
  .search-modal .predictive-search-results__card--product {
    &,
    &:hover,
    &:is([aria-selected='true'].keyboard-focus, :focus-visible, :has(.resource-card:focus-visible)) {
      padding: 0;
      margin: 0;
      background: transparent;
      border-radius: 0;
      outline: none;
    }

    &[aria-selected='true'] {
      outline: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
      outline-offset: 2px;
    }

    .resource-card__content {
      align-items: center;
      text-align: center;
    }

    .resource-card__title {
      font-size: var(--font-size--sm);
    }
  }
{% endstylesheet %}
